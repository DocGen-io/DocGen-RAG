{
  "openapi": "3.0.0",
  "info": {
    "title": "Conduit",
    "description": "Collection for testing the Conduit API\n\nhttps://github.com/gothinkster/realworld",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.realworld.io/api",
      "description": "Default server"
    }
  ],
  "tags": [
    { "name": "Auth" },
    { "name": "Articles" },
    { "name": "Articles, Favorite, Comments" },
    { "name": "Profiles" },
    { "name": "Tags" }
  ],
  "paths": {
    "/users": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "example": {
                  "user": {
                    "email": "user@example.com",
                    "password": "password",
                    "username": "username"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Auto-generated successful response"
          }
        }
      }
    },
    "/users/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "example": {
                  "user": {
                    "email": "user@example.com",
                    "password": "password"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Auto-generated successful response"
          }
        }
      }
    },
    "/user": {
      "get": {
        "tags": ["Auth"],
        "summary": "Current User",
        "responses": {
          "200": {
            "description": "Auto-generated successful response"
          }
        }
      },
      "put": {
        "tags": ["Auth"],
        "summary": "Update User",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "example": {
                  "user": {
                    "email": "newemail@example.com"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Auto-generated successful response"
          }
        }
      }
    },
    "/articles": {
      "get": {
        "tags": ["Articles"],
        "summary": "All Articles (Allows Query Params)",
        "parameters": [
          {
            "name": "author",
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "favorited",
            "in": "query",
            "schema": { "type": "string" }
          },
          {
            "name": "tag",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Auto-generated successful response"
          }
        }
      },
      "post": {
        "tags": ["Articles, Favorite, Comments"],
        "summary": "Create Article",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "example": {
                  "article": {
                    "title": "How to train your dragon",
                    "description": "Ever wonder how?",
                    "body": "Very carefully.",
                    "tagList": ["training", "dragons"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Auto-generated successful response"
          }
        }
      }
    },
