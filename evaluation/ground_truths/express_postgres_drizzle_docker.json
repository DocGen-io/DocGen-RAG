      "delete": {
        "tags": ["Articles, Favorite, Comments"],
        "summary": "Unfavorite Article",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Auto-generated successful response"
          }
        }
