# .llmignore

# --- Base Version Control & Environments ---
.git/
.venv/
venv/
env/
.idea/
.vscode/
__pycache__/

# --- Node.js / NestJS ---
node_modules/
dist/
coverage/
package-lock.json
yarn.lock
pnpm-lock.yaml
tsconfig.build.json
.tsbuildinfo
out/
out-tsc/
.next/
nuxt/
.svelte-kit/
.husky/
.nyc_output/

# Test files & Mocks
*.spec.ts
*.test.ts
*.e2e-spec.ts
__tests__/
__mocks__/

# --- Java / Spring Boot ---
.mvn/
.gradle/
target/
build/
mvnw
mvnw.cmd
gradlew
gradlew.bat
*.class
*.jar
*.war
*.ear
*.nar
.bsp/
.classpath
.project
.settings/
HELP.md
lombok.config

# --- .NET / C# ---
bin/
obj/
TestResults/
.vs/
*.csproj.user
*.suo
*.user
*.userosscache
*.sln.docstates
*.pdb
*.dll
*.exe
*.cache
packages/
.nuget/
[Bb]in/
[Oo]bj/

# Test Projects (common naming conventions)
*Tests/
*Test/
*.UnitTests/
*.IntegrationTests/


# --- Common Configs & Boilerplate (Not useful for API docs) ---
.gitignore
.dockerignore
Dockerfile
docker-compose.yml
.eslintrc*
.prettierrc*
jest.config.*
nest-cli.json
README.md
LICENSE

# --- Media & Assets ---
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.ico
*.mp4
*.pdf
*.zip
*.tar.gz
*.woff
*.woff2
*.ttf
*.eot

# --- Documentation ---
docs/
swagger/

# --- CI/CD ---
.github/
.gitlab/
.circleci/

# --- Frontend / Static Assets (when repository is full-stack) ---
public/
web/
client/
frontend/
ui/
assets/
images/

# --- Database / Migrations (Usually not containing endpoints) ---
Migrations/
migrations/
db/migrations/
liquibase/
flyway/

*Test.java